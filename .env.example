DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=pf
TEST_DB_NAME=pf_test
DB_USER=pf
DB_PASSWORD=local-demo-only
PORT=3000
MARKET_PROVIDER=csv
ADMIN_TOKEN=local-basket-admin-change-me
# MARKET_PROVIDER=alpha requests live data; never falls back silently
ALPHA_VANTAGE_KEY=
# Optional live quote/news panel; simulator remains on MARKET_PROVIDER.
FINNHUB_API_KEY=
# Optional HTTPS service implementing the AI explanation contract
AI_URL=
AI_KEY=

# csv uses bundled user-supplied historical files; offline selects synthetic test/demo data.

# strict: 5-minute quotes; demo-last-quote: hypothetical Finnhub fills up to 7 days old
EXECUTION_MODE=strict
