# MySQL (create the pf and pf_test databases first, see README)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pf
DB_USER=pf
DB_PASSWORD=your_password
TEST_DB_NAME=pf_test

# Free Finnhub key from https://finnhub.io (real-time prices)
FINNHUB_API_KEY=

# demo-last-quote works when the market is closed, strict needs a quote under 5 minutes old
EXECUTION_MODE=demo-last-quote

PORT=3000
