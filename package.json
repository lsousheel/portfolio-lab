{
  "name": "programming-finance",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/src/server.js",
    "migrate": "node dist/src/cli.js migrate",
    "quotes": "node dist/src/cli.js quotes",
    "watch": "node dist/src/cli.js watch",
    "test": "npm run build && jasmine --config=tests/jasmine.json",
    "test:unit": "npm test"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "mysql2": "^3.15.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/jasmine": "^5.1.9",
    "@types/node": "^22.19.0",
    "@types/supertest": "^6.0.3",
    "jasmine": "^5.12.0",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "typescript": "^5.9.3"
  }
}
