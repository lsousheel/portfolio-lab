{
  "openapi": "3.1.0",
  "info": {
    "title": "Programming Finance Simulator",
    "version": "1.0.0",
    "description": "Local academic simulation. Monetary values are decimal strings. No real brokerage or live execution. Synthetic default provider. Order failures leave pending orders unchanged; batches record business rejections."
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "security": [
    {
      "LocalBearer": []
    }
  ],
  "components": {
    "securitySchemes": {
      "LocalBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Token from POST /users; local demo only"
      },
      "AdminBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "ADMIN_TOKEN environment value"
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Simulator health",
        "operationId": "get__health",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token"
          },
          "404": {
            "description": "Absent or not owned"
          },
          "409": {
            "description": "State or idempotency conflict"
          },
          "422": {
            "description": "Invalid input, insufficient resources or stale quote"
          },
          "500": {
            "description": "Internal error; transaction rolled back"
          },
          "503": {
            "description": "Provider quota or availability error"
          }
        },
        "security": []
      }
    },
